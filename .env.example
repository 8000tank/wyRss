# =========================
# Readwise
# =========================
READWISE_TOKEN=your_readwise_token
READWISE_BASE_URL=https://readwise.io/api/v3

# 如果只抓 Reader 里的 RSS 文章，保持下面两个默认值即可。
# 如果要抓 Reader 里的全部文章，可以留空：
# READWISE_LOCATION=
# READWISE_CATEGORY=
READWISE_LOCATION=feed
READWISE_CATEGORY=rss
READWISE_WITH_HTML_CONTENT=true
REQUEST_TIMEOUT_SECONDS=30

# =========================
# Digest
# =========================
DIGEST_HOURS=24
DIGEST_CANDIDATE_LIMIT=30
DIGEST_TOP_N=10
DIGEST_OUTPUT_DIR=output
DIGEST_LANGUAGE=中文
DIGEST_SCORING_FOCUS=信息价值优先，其次考虑新颖度、可执行性和与技术/AI资讯的相关性。

# =========================
# LLM (OpenAI compatible)
# 下面三项只保留一套你实际要用的配置
# =========================
LLM_API_KEY=your_openai_compatible_api_key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.5-flash

# ---- 智谱示例 ----
# LLM_API_KEY=your_zhipu_api_key
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4.5-flash

# ---- MiniMax OpenAI兼容示例 ----
# 注意：MiniMax 的 OpenAI 兼容端点是 /v1，不是 /anthropic
# 不同时间点官方兼容地址或模型名可能会调整，
# 如果你自己的控制台给出的地址不同，以控制台为准。
# LLM_API_KEY=your_minimax_api_key
# LLM_BASE_URL=https://api.minimaxi.com/v1
# LLM_MODEL=MiniMax-M2.5

LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_MAX_INPUT_CHARS=6000
