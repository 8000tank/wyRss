# =========================
# Readwise
# =========================
READWISE_TOKEN=your_readwise_token
READWISE_BASE_URL=https://readwise.io/api/v3

# 只锁 location=feed；不再固定 category（让多桶配置接管）。
# 留空 READWISE_CATEGORY 表示"未指定就回退到全部分类"。
READWISE_LOCATION=feed
READWISE_CATEGORY=

# READWISE_FETCH_BUCKETS：以 "category[@location]:max_items" 列表声明每桶配额。
# 例如下面的默认值表示：本轮拉 60 篇 feed RSS + 20 篇 new newsletter（email），
# 这样 newsletter 不会被高频中文 AI 公众号挤掉。
# 留空则回退到旧的"单桶 = READWISE_CATEGORY + DIGEST_CANDIDATE_LIMIT"行为。
READWISE_FETCH_BUCKETS=rss@feed:60,email@new:20

READWISE_WITH_HTML_CONTENT=true
REQUEST_TIMEOUT_SECONDS=30

# =========================
# Digest
# =========================
DIGEST_HOURS=24
DIGEST_CANDIDATE_LIMIT=120
DIGEST_PRE_SCORE_LIMIT=30
DIGEST_TOP_N=12

# 终选阶段的多样性硬约束。同一站点 / 作者最多入选 N 篇。
# 把 max_per_site 设大（如 999）等价于关闭站点维度。
DIGEST_MAX_PER_SITE=2
DIGEST_MAX_PER_AUTHOR=2

# 题材白名单。预多样性筛选时按这些桶均衡，未列入的会归入 "other" 桶。
DIGEST_TOPIC_BUCKETS=ai,security,infra,research,business,other

DIGEST_OUTPUT_DIR=output
DIGEST_LANGUAGE=中文
DIGEST_SCORING_FOCUS=信息价值优先；兼顾 AI 研究/产品、基础设施与云、网络安全、工程实践与行业战略；优先选择有独立观察、数据或可操作结论的内容，避免新闻搬运与公关稿。
DIGEST_TIMEZONE=Asia/Shanghai
# 有明确 published_date 或标题日期的文章，超过 N 天会被排除；留给无日期文章继续参与。
DIGEST_MAX_PUBLISHED_AGE_DAYS=7

# =========================
# LLM (OpenAI compatible)
# 下面三项只保留一套你实际要用的配置
# =========================
RSS_LLM_API_KEY=your_openai_compatible_api_key
RSS_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
RSS_LLM_MODEL=glm-4.5-flash
# 若未设置上述 RSS_* 变量，仍会回退读取旧名：LLM_API_KEY、LLM_BASE_URL、LLM_MODEL

# ---- 智谱示例 ----
# RSS_LLM_API_KEY=your_zhipu_api_key
# RSS_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# RSS_LLM_MODEL=glm-4.5-flash

# ---- MiniMax OpenAI兼容示例 ----
# 注意：MiniMax 的 OpenAI 兼容端点是 /v1，不是 /anthropic
# 不同时间点官方兼容地址或模型名可能会调整，
# 如果你自己的控制台给出的地址不同，以控制台为准。
# RSS_LLM_API_KEY=your_minimax_api_key
# RSS_LLM_BASE_URL=https://api.minimaxi.com/v1
# RSS_LLM_MODEL=MiniMax-M3

LLM_TIMEOUT_SECONDS=60
LLM_CONCURRENCY=2
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
LLM_MAX_INPUT_CHARS=6000
# MiniMax M2/M3 系列会自动启用 reasoning_split；这里可显式覆盖 true/false。
# LLM_REASONING_SPLIT=true
